{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "validate:model": "node scripts/validate-model.mjs",
    "validate:home": "node scripts/validate-home.mjs",
    "validate:partner-adhc": "node scripts/build-partner-adhc.mjs --check && node scripts/validate-partner-adhc.mjs",
    "validate:day-program": "node scripts/validate-day-program.mjs",
    "validate:traffic": "node scripts/compile-model-modules.mjs && node scripts/validate-traffic.mjs",
    "validate:fleet": "node scripts/validate-fleet-crew.mjs",
    "validate:community": "node scripts/compile-model-modules.mjs && node scripts/validate-community-traffic.mjs",
    "plan:traffic": "node scripts/compile-model-modules.mjs && node scripts/plan-street-traffic.mjs && npm run validate:traffic",
    "prebuild": "node scripts/prepare-public-models.mjs && node scripts/validate-public-assets.mjs",
    "build:scenario": "node scripts/build-scenario.mjs",
    "build:community": "node scripts/build-community-tracks.mjs",
    "sim:report": "node scripts/sim-report.mjs",
    "trace:report": "node scripts/sim-report.mjs --trace-only",
    "validate:trace": "node scripts/validate-trace.mjs",
    "validate:renderer": "node scripts/validate-renderer.mjs",
    "validate:layout": "node scripts/compile-model-modules.mjs && node scripts/validate-layout.mjs && node scripts/validate-interior.mjs",
    "validate:sites": "node scripts/compile-model-modules.mjs && node scripts/validate-additional-sites.mjs && node scripts/validate-room-review.mjs && node scripts/validate-olympic-day-spaces.mjs && node scripts/validate-olympic-exterior.mjs && node scripts/validate-site-activity.mjs && node scripts/validate-site-arrivals.mjs",
    "validate:activity": "node scripts/compile-model-modules.mjs && node scripts/validate-activity.mjs && node scripts/validate-day-life.mjs && node scripts/validate-community.mjs",
    "validate:scenario": "node scripts/build-scenario.mjs --check",
    "validate:community-tracks": "node scripts/build-community-tracks.mjs --check",
    "validate:public": "node scripts/validate-public-assets.mjs",
    "validate": "tsc --noEmit --incremental false && npm run validate:model && npm run validate:home && npm run validate:layout && npm run validate:sites && npm run validate:day-program && npm run validate:community-tracks && npm run validate:partner-adhc && npm run validate:activity && npm run validate:traffic && npm run validate:fleet && npm run validate:community && npm run validate:scenario && npm run validate:trace && npm run validate:renderer && npm run validate:public",
    "test": "npm run validate && npm run test:unit",
    "test:unit": "node scripts/test.mjs",
    "dev:story": "vite --config vite.story.config.ts",
    "build:story": "vite build --config vite.story.config.ts",
    "preview:story": "vite preview --config vite.story.config.ts",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "preview:viewer": "vite preview --config vite.viewer.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
